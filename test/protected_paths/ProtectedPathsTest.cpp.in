TEST(ProtectedPaths, CredentialsVariantsAndSiblingsAreDenied) {
  for (auto p : {"/.crosspoint/wifi.json", "/.CrossPoint/OPDS.JSON", "/.crosspoint/koreader.json.bak",
       "/.crosspoint/wifi.json.tmp", "/.crosspoint/wifi.json.davtmp", "/.crosspoint/wifi.json.",
       "/ .crosspoint./ wifi.json ", "//.crosspoint//./wifi.json", "/Books/../../.crosspoint/wifi.json",
       "/.crosspoint/../.crosspoint/opds.json", "/CROSSP~1/wifi.json", "/.crosspoint/WIFI~1.JSO"})
    EXPECT_TRUE(protectedpaths::isSensitivePath(p)) << p;
}
TEST(ProtectedPaths, KoreanAndOrdinaryFilesStayAccessible) {
  for (auto p : {"/Books/a.epub", "/책/한글 책.txt", "/설정/개인.json", "/Books/wifi.json",
       "/.crosspoint/settings.json", "/Books/Photos/IMG~1.JPG", "/Books/a~b.epub"})
    EXPECT_FALSE(protectedpaths::isSensitivePath(p)) << p;
}
TEST(ProtectedPaths, InvalidBytesAndComponentsFailClosed) {
  for (std::string p : {std::string(""), std::string("/Books\\..\\.crosspoint/wifi.json"), std::string("C:/wifi.json"),
       std::string("/Books/")+char(0x80), std::string("/Books/\xC0\xAE"), std::string("/Books/\xED\xA0\x80"),
       std::string("/Books/\xF4\x90\x80\x80"), std::string("/Books/\xE3\x80"), std::string("/Books\0/x",9)})
    EXPECT_TRUE(protectedpaths::isSensitivePath(p));
  for (auto name : {"", ".", "..", "../x", "nested/../x", "/x", "a/b", "a\\b"})
    EXPECT_FALSE(FsHelpers::isSafePathComponent(String(name))) << name;
}
TEST(ProtectedPaths, HttpAndWebsocketPersistenceGuardFinalConstructedPath) {
  for (auto parent : {"/.crosspoint", "/CROSSP~1", "/Books/../.CrossPoint .", "/ .crosspoint", "/Books\\.."}) {
    Storage = {};
    CrossPointWebServer web;
    web.server->args["path"] = parent;
    web.server->incoming.filename = "wifi.json.tmp";
    CrossPointWebServer::UploadState state;
    web.uploadBegin(state);
    EXPECT_FALSE(state.error.isEmpty()) << parent;
    EXPECT_TRUE(Storage.mutations.empty());
    wsUploadPath = normalizeWebPath(parent); wsUploadFileName = "wifi.json.tmp";
    wsStart();
    EXPECT_TRUE(Storage.mutations.empty());
  }
  for (auto name : {"normal.json", "한국어 설정.json"}) {
    Storage = {}; CrossPointWebServer web;
    web.server->args["path"] = "/설정"; web.server->incoming.filename = name;
    CrossPointWebServer::UploadState state; web.uploadBegin(state);
    EXPECT_TRUE(state.error.isEmpty()); ASSERT_EQ(Storage.mutations.size(), 1U);
    EXPECT_EQ(Storage.mutations[0], "write:/설정/" + std::string(name));
    Storage = {}; wsUploadPath = "/설정"; wsUploadFileName = name; wsStart();
    ASSERT_EQ(Storage.mutations.size(), 1U);
  }
}
TEST(ProtectedPaths, HttpRenameMoveAndMkdirCannotTargetCredentials) {
  CrossPointWebServer web;
  Storage = {}; Storage.entries["/.crosspoint/ordinary.json"] = false;
  web.server->args = {{"path", "/.crosspoint/ordinary.json"}, {"name", "wifi.json.tmp"}};
  web.handleRename(); EXPECT_EQ(web.server->status,403); EXPECT_TRUE(Storage.mutations.empty());
  Storage = {}; Storage.entries["/Books/wifi.json"] = false; Storage.entries["/ .crosspoint"] = true;
  Storage.entries["/.crosspoint"] = true;
  web.server->args = {{"path", "/Books/wifi.json"}, {"dest", "/ .crosspoint"}};
  web.handleMove(); EXPECT_EQ(web.server->status,403); EXPECT_TRUE(Storage.mutations.empty());
  web.server->args = {{"path", "/.crosspoint"}, {"name", "opds.json"}};
  web.handleCreateFolder(); EXPECT_EQ(web.server->status,403); EXPECT_TRUE(Storage.mutations.empty());
}
TEST(ProtectedPaths, ActualRenamePreservesKoreanNamesAndRejectsInvalidComponents) {
  for (auto name : {".", "..", "../escape", "a/b", "a\\b", ""}) {
    Storage = {}; Storage.entries["/Books/old.json"] = false; CrossPointWebServer web;
    web.server->args = {{"path", "/Books/old.json"}, {"name", name}};
    web.handleRename(); EXPECT_GE(web.server->status,400); EXPECT_TRUE(Storage.mutations.empty());
  }
  Storage = {}; Storage.entries["/Books/old.json"] = false; CrossPointWebServer web;
  web.server->args = {{"path", "/Books/old.json"}, {"name", "한국어.json"}};
  web.handleRename(); EXPECT_EQ(web.server->status,200);
  ASSERT_EQ(Storage.mutations.size(),1U); EXPECT_EQ(Storage.mutations[0],"rename:/Books/한국어.json");
}
TEST(ProtectedPaths, HttpDownloadGuardsBeforeOpeningCredentialFiles) {
  for (auto path : {"/.crosspoint/wifi.json", "/ .CrossPoint ./ OPDS.JSON ", "/CROSSP~1/koreader.json",
       "/Books/../.crosspoint/wifi.json.tmp", "/.crosspoint/WIFI~1.JSO"}) {
    Storage = {}; Storage.entries[normalizeWebPath(path)] = false; CrossPointWebServer web;
    web.server->args["path"] = path; web.handleDownload();
    EXPECT_EQ(web.server->status, 403); EXPECT_TRUE(Storage.reads.empty());
  }
  Storage = {}; Storage.entries["/Books/한글.json"] = false; CrossPointWebServer web;
  web.server->args["path"] = "/Books/한글.json"; web.handleDownload();
  ASSERT_EQ(Storage.reads.size(), 1U); EXPECT_EQ(Storage.reads[0], "/Books/한글.json");
}
TEST(ProtectedPaths, HttpUploadRejectsMalformedNamesBeforePersistence) {
  for (const auto& name : {std::string("bad\0name", 8), std::string("\xED\xA0\x80"), std::string("../wifi.json"),
       std::string("."), std::string(".."), std::string(""), std::string("C:/file"), std::string("a\\b")}) {
    Storage = {}; CrossPointWebServer web; web.server->args["path"] = "/Books";
    web.server->incoming.filename = name; CrossPointWebServer::UploadState state; web.uploadBegin(state);
    EXPECT_FALSE(state.error.isEmpty()); EXPECT_TRUE(Storage.mutations.empty());
  }
}
TEST(ProtectedPaths, HttpDeleteGuardsEveryBatchItemBeforePersistence) {
  Storage = {};
  EXPECT_FALSE(deletePaths({{"/.crosspoint/wifi.json"}, {"/CROSSP~1/opds.json.bak"},
                           {"/Books/../.crosspoint/koreader.json"}}));
  EXPECT_TRUE(Storage.reads.empty()); EXPECT_TRUE(Storage.mutations.empty());
  Storage.entries["/Books/한글.json"] = false;
  EXPECT_TRUE(deletePaths({{"/Books/한글.json"}}));
  ASSERT_EQ(Storage.mutations.size(), 1U); EXPECT_EQ(Storage.mutations[0], "remove:/Books/한글.json");
}
TEST(ProtectedPaths, WebdavDecodedRequestAndDestinationBlockAliasesAndUtf8Attacks) {
  WebDAVHandler dav; WebServer s;
  for (auto uri : {"/%2ecrosspoint/wifi.json", "/CROSSP~1/opds.json", "/Books/%2e%2e/.crosspoint/koreader.json",
       "/Books/%5c../.crosspoint/wifi.json", "/Books/%00/.crosspoint/wifi.json", "/Books/%c0%ae"}) {
    s.requestUri = uri; s.destination = "http://reader" + std::string(uri);
    EXPECT_TRUE(dav.isProtectedPath(dav.getRequestPath(s))) << uri;
    EXPECT_TRUE(dav.isProtectedPath(dav.getDestinationPath(s))) << uri;
    Storage = {}; HTTPRaw raw{RAW_START}; dav.raw(s,"",raw);
    EXPECT_FALSE(dav._putOk); EXPECT_TRUE(Storage.mutations.empty());
    raw.status = RAW_ABORTED; dav.raw(s,"",raw); EXPECT_TRUE(Storage.mutations.empty());
  }
  s.requestUri = "/책/%ED%95%9C%EA%B8%80.json";
  EXPECT_EQ(dav.getRequestPath(s),"/책/한글.json");
  EXPECT_FALSE(dav.isProtectedPath(dav.getRequestPath(s)));
}

TEST(NetworkBoundary, DeniesHiddenEncodedTransactionAndAliasPathsAtBothEndpoints) {
  for(auto path : {"/.crosspoint/settings.json", "/books/.secret/a", "/books/a.davtmp", "/books/a.DAVBAK", "/System Volume Information/a", "/xtcache/a", "/%252e%252e/a", "/%", "/a\\b", "relative/a"}) {
    WebDAVHandler dav;WebServer server;server.requestUri=path;
    EXPECT_TRUE(dav.isProtectedPath(dav.getRequestPath(server)))<<path;
    auto normalized=normalizeWebPath(path);
    EXPECT_TRUE(normalized.isEmpty() || protectedpaths::isNetworkPathProtected(normalized.c_str()))<<path;
  }
}
TEST(NetworkTransactions, PutPreservesOriginalOnShortWriteAndClosesTemporary) {
  for(size_t limit : {size_t{0},size_t{1}}) {
    Storage={};cleared.clear();Storage.entries["/book.epub"]=false;Storage.data["/book.epub"]="old";
    WebServer server;server.requestUri="/book.epub";WebDAVHandler dav;
    HTTPRaw raw{RAW_START};dav.raw(server,"",raw);ASSERT_TRUE(dav._putOk);
    Storage.writeLimit=limit;const uint8_t bytes[]={1,2};raw={RAW_WRITE,bytes,2,2};dav.raw(server,"",raw);
    raw.status=RAW_END;dav.raw(server,"",raw);
    EXPECT_FALSE(dav._putOk);EXPECT_FALSE(dav._putFile.opened);EXPECT_EQ(Storage.data["/book.epub"],"old");
    EXPECT_FALSE(Storage.exists("/book.epub.davtmp"));EXPECT_TRUE(cleared.empty());
  }
}
TEST(NetworkTransactions, PutChecksCloseByteCountAndPromotionRollback) {
  for(int failure=0;failure<4;++failure) {
    Storage={};cleared.clear();Storage.entries["/book.epub"]=false;Storage.data["/book.epub"]="old";
    WebServer server;server.requestUri="/book.epub";WebDAVHandler dav;HTTPRaw raw{RAW_START};dav.raw(server,"",raw);
    const uint8_t bytes[]={1,2};raw={RAW_WRITE,bytes,2,2};dav.raw(server,"",raw);
    if(failure==0)Storage.failClose=true;
    if(failure==1)raw.totalSize=3;
    if(failure==2)Storage.failRename="/book.epub.davtmp";
    if(failure==3)Storage.failRename="/book.epub";
    raw.status=RAW_END;dav.raw(server,"",raw);
    EXPECT_FALSE(dav._putOk);EXPECT_EQ(Storage.data["/book.epub"],"old");EXPECT_TRUE(cleared.empty());
  }
}
TEST(NetworkTransactions, PutSuccessAbortAndRepeatedStartOnlyCleanOwnedFiles) {
  Storage={};cleared.clear();WebServer server;server.requestUri="/new.epub";WebDAVHandler dav;
  HTTPRaw raw{RAW_START};dav.raw(server,"",raw);const uint8_t bytes[]={1,2};
  raw={RAW_WRITE,bytes,2,2};dav.raw(server,"",raw);raw.status=RAW_END;dav.raw(server,"",raw);
  EXPECT_TRUE(dav._putOk);EXPECT_EQ(Storage.data["/new.epub"],std::string("\x01\x02",2));EXPECT_EQ(cleared.size(),1U);
  raw.status=RAW_START;dav.raw(server,"",raw);raw.status=RAW_ABORTED;dav.raw(server,"",raw);
  EXPECT_EQ(Storage.data["/new.epub"],std::string("\x01\x02",2));EXPECT_FALSE(Storage.exists("/new.epub.davtmp"));
  Storage.entries["/new.epub.davtmp"]=false;Storage.data["/new.epub.davtmp"]="recovery";
  raw.status=RAW_START;dav.raw(server,"",raw);raw.status=RAW_ABORTED;dav.raw(server,"",raw);
  EXPECT_EQ(Storage.data["/new.epub.davtmp"],"recovery");
}
TEST(NetworkTransactions, DeleteFailureDoesNotClearMetadataInWebOrDav) {
  Storage={};cleared.clear();Storage.entries["/book.epub"]=false;Storage.failRemove="/book.epub";
  EXPECT_FALSE(deletePaths({{String("/book.epub")}}));EXPECT_TRUE(cleared.empty());
  WebDAVHandler dav;WebServer server;server.requestUri="/book.epub";dav.handleDelete(server);
  EXPECT_EQ(server.status,500);EXPECT_TRUE(Storage.exists("/book.epub"));EXPECT_TRUE(cleared.empty());
}
TEST(NetworkTransactions, MoveRollbackPreservesBothFilesAndMetadata) {
  Storage={};cleared.clear();Storage.entries["/a.epub"]=false;Storage.data["/a.epub"]="a";
  Storage.entries["/b.epub"]=false;Storage.data["/b.epub"]="b";Storage.failRename="/a.epub";
  WebDAVHandler dav;WebServer server;server.requestUri="/a.epub";server.destination="/b.epub";dav.handleMove(server);
  EXPECT_EQ(server.status,500);EXPECT_EQ(Storage.data["/a.epub"],"a");EXPECT_EQ(Storage.data["/b.epub"],"b");EXPECT_TRUE(cleared.empty());
}
TEST(NetworkTransactions, CopyFailureKeepsExistingDestination) {
  for(int failure=0;failure<4;++failure) {
    Storage={};cleared.clear();allocationFails=failure==3;
    Storage.entries["/a.epub"]=false;Storage.data["/a.epub"]="abc";Storage.entries["/b.epub"]=false;Storage.data["/b.epub"]="old";
    if(failure==0)Storage.failRead=true;if(failure==1)Storage.writeLimit=0;if(failure==2)Storage.failClose=true;
    WebDAVHandler dav;WebServer server;server.requestUri="/a.epub";server.destination="/b.epub";dav.handleCopy(server);
    EXPECT_EQ(server.status,500);EXPECT_EQ(Storage.data["/b.epub"],"old");EXPECT_TRUE(cleared.empty());
    EXPECT_FALSE(Storage.exists("/b.epub.davtmp"));allocationFails=false;
  }
}
TEST(NetworkTransactions, CopyAndMoveSuccessReportActualCommit) {
  Storage={};cleared.clear();Storage.entries["/a.epub"]=false;Storage.data["/a.epub"]="abc";
  WebDAVHandler dav;WebServer server;server.requestUri="/a.epub";server.destination="/b.epub";dav.handleCopy(server);
  EXPECT_EQ(server.status,201);EXPECT_EQ(Storage.data["/b.epub"],"abc");
  server.destination="/c.epub";dav.handleMove(server);EXPECT_EQ(server.status,201);EXPECT_FALSE(Storage.exists("/a.epub"));EXPECT_EQ(Storage.data["/c.epub"],"abc");
}

TEST(NetworkTransactions, HttpUploadWriteCloseAbortAndCollisionPreserveOwnership) {
  for(int failure=0;failure<5;++failure) {
    Storage={};cleared.clear();CrossPointWebServer web;web.server->incoming.filename="upload.epub";
    CrossPointWebServer::UploadState state;
    if(failure==4){Storage.entries["/upload.epub"]=false;Storage.data["/upload.epub"]="old";}
    web.handleUpload(state);
    if(failure==4){web.handleUploadPost(state);EXPECT_EQ(Storage.data["/upload.epub"],"old");EXPECT_TRUE(cleared.empty());continue;}
    ASSERT_TRUE(state.ownsFile);std::vector<uint8_t> bytes(4097,42);
    if(failure==0)Storage.writeLimit=0;
    if(failure==1)Storage.writeLimit=2;
    web.server->incoming.status=UPLOAD_FILE_WRITE;web.server->incoming.buf=bytes.data();web.server->incoming.currentSize=bytes.size();web.handleUpload(state);
    if(failure==2)Storage.failClose=true;
    web.server->incoming.status=failure==3?UPLOAD_FILE_ABORTED:UPLOAD_FILE_END;web.handleUpload(state);web.handleUploadPost(state);
    EXPECT_FALSE(state.success);EXPECT_FALSE(state.file.opened);EXPECT_FALSE(Storage.exists("/upload.epub"));EXPECT_TRUE(cleared.empty());
  }
}
TEST(NetworkTransactions, HttpUploadSuccessAndDisconnectCleanup) {
  for(bool disconnect:{false,true}) {
    Storage={};cleared.clear();CrossPointWebServer web;web.server->incoming.filename="upload.epub";CrossPointWebServer::UploadState state;web.handleUpload(state);
    const uint8_t data[]={1,2,3};web.server->incoming={"upload.epub",UPLOAD_FILE_WRITE,data,3};web.handleUpload(state);
    web.server->connection.live=!disconnect;web.server->incoming.status=UPLOAD_FILE_END;web.handleUpload(state);web.handleUploadPost(state);
    EXPECT_EQ(state.success,!disconnect);EXPECT_EQ(Storage.exists("/upload.epub"),!disconnect);EXPECT_EQ(cleared.empty(),disconnect);
    if(!disconnect)EXPECT_EQ(Storage.data["/upload.epub"],std::string("\x01\x02\x03",3));
  }
}

TEST(NetworkTransactions, FontCollisionOomAbortAndShortFileNeverRemoveExistingFont) {
  for(int failure=0;failure<4;++failure) {
    Storage={};allocationFails=false;CrossPointWebServer web;web.server->args["family"]="Ko";web.server->incoming.filename="Ko_14.cpfont";
    const char* path="/.fonts/Ko/Ko_14.cpfont";
    if(failure==0){Storage.entries[path]=false;Storage.data[path]="existing";Storage.entries[std::string(path)+".davbak"]=false;}
    allocationFails=failure==1;web.handleFontUploadData();allocationFails=false;
    if(failure==2){const uint8_t partial[]={1};web.server->incoming.status=UPLOAD_FILE_WRITE;web.server->incoming.buf=partial;web.server->incoming.currentSize=1;web.handleFontUploadData();}
    web.server->incoming.status=failure==3?UPLOAD_FILE_ABORTED:UPLOAD_FILE_END;web.handleFontUploadData();
    EXPECT_FALSE(web.fontUpload.valid);EXPECT_FALSE(web.fontUpload.ownsFile);EXPECT_FALSE(web.fontUpload.file.opened);
    if(failure==0)EXPECT_EQ(Storage.data[path],"existing");else EXPECT_FALSE(Storage.exists(path));
  }
}
TEST(NetworkTransactions, FontMagicAcrossChunksAndCloseFailure) {
  for(bool failedClose:{false,true}) {
    Storage={};CrossPointWebServer web;web.server->args["family"]="Ko";web.server->incoming.filename="Ko_14.cpfont";web.handleFontUploadData();
    const uint8_t bytes[]={'C','P','F','O','N','T',0,0,4};
    for(size_t i=0;i<sizeof(bytes);++i){web.server->incoming.status=UPLOAD_FILE_WRITE;web.server->incoming.buf=bytes+i;web.server->incoming.currentSize=1;web.handleFontUploadData();}
    Storage.failClose=failedClose;web.server->incoming.status=UPLOAD_FILE_END;web.handleFontUploadData();
    EXPECT_EQ(web.fontUpload.valid,!failedClose);EXPECT_EQ(Storage.exists("/.fonts/Ko/Ko_14.cpfont"),!failedClose);
  }
}

TEST(NetworkTransactions, FontReplacementKeepsPreviousFileOnFailureAndPublishesAfterClose) {
  for(bool fail:{false,true}) {
    Storage={};CrossPointWebServer web;web.server->args["family"]="Ko";web.server->incoming.filename="Ko_14.cpfont";
    const char* path="/.fonts/Ko/Ko_14.cpfont";Storage.entries[path]=false;Storage.data[path]="existing";web.handleFontUploadData();
    const uint8_t bytes[]={'C','P','F','O','N','T',0,0,4};web.server->incoming.status=UPLOAD_FILE_WRITE;web.server->incoming.buf=bytes;web.server->incoming.currentSize=sizeof(bytes);web.handleFontUploadData();
    if(fail)Storage.failRename=std::string(path)+".davtmp";
    web.server->incoming.status=UPLOAD_FILE_END;web.handleFontUploadData();
    EXPECT_EQ(web.fontUpload.valid,!fail);if(fail)EXPECT_EQ(Storage.data[path],"existing");else EXPECT_EQ(Storage.data[path].size(),sizeof(bytes));
  }
}

TEST(NetworkTransactions, WebdavDestructionClosesAndRemovesOnlyOwnedPartialFile) {
 Storage={};{ WebDAVHandler dav;WebServer server;server.requestUri="/book.epub";HTTPRaw raw{RAW_START};dav.raw(server,"",raw);ASSERT_TRUE(dav._putFile.opened); }
 EXPECT_FALSE(Storage.exists("/book.epub.davtmp"));
 Storage.entries["/book.epub.davtmp"]=false;Storage.data["/book.epub.davtmp"]="recovery";
 {WebDAVHandler dav;WebServer server;server.requestUri="/book.epub";HTTPRaw raw{RAW_START};dav.raw(server,"",raw);EXPECT_FALSE(dav._putOk);}
 EXPECT_EQ(Storage.data["/book.epub.davtmp"],"recovery");
}

TEST(NetworkReview, PutFinalHandlerNeverDeletesUnownedRecoveryAndConsumesCommitOnce) {
  Storage={};cleared.clear();Storage.entries["/book.epub.davtmp"]=false;Storage.data["/book.epub.davtmp"]="recovery";
  WebDAVHandler dav;WebServer server;server.requestUri="/book.epub";HTTPRaw raw{RAW_START};dav.raw(server,"",raw);
  const uint8_t data[]={1};raw={RAW_WRITE,data,1,1};dav.raw(server,"",raw);raw.status=RAW_END;dav.raw(server,"",raw);dav.handlePut(server);
  EXPECT_EQ(server.status,500);EXPECT_EQ(Storage.data["/book.epub.davtmp"],"recovery");EXPECT_TRUE(cleared.empty());
  Storage={};server.requestUri="/ok.epub";raw={RAW_START};dav.raw(server,"",raw);raw={RAW_WRITE,data,1,1};dav.raw(server,"",raw);raw.status=RAW_END;dav.raw(server,"",raw);
  dav.handlePut(server);EXPECT_EQ(server.status,201);EXPECT_EQ(cleared.size(),1U);
  dav.handlePut(server);EXPECT_EQ(server.status,500);EXPECT_EQ(cleared.size(),1U);
}
TEST(NetworkReview, CopyAndMoveRejectExistingDirectoryWithoutMovingOrDeletingItsTree) {
  for(bool move:{false,true}) {
    Storage={};cleared.clear();Storage.entries["/a.epub"]=false;Storage.data["/a.epub"]="a";
    Storage.entries["/books"]=true;Storage.entries["/books/child.epub"]=false;Storage.data["/books/child.epub"]="child";
    WebDAVHandler dav;WebServer server;server.requestUri="/a.epub";server.destination="/books";
    if(move)dav.handleMove(server);else dav.handleCopy(server);
    EXPECT_GE(server.status,400);EXPECT_TRUE(Storage.entries.at("/books"));EXPECT_EQ(Storage.data["/books/child.epub"],"child");
    EXPECT_EQ(Storage.data["/a.epub"],"a");EXPECT_FALSE(Storage.exists("/books.davbak"));EXPECT_TRUE(cleared.empty());
    EXPECT_TRUE(std::none_of(Storage.mutations.begin(),Storage.mutations.end(),[](const auto& op){return op.starts_with("rename:");}));
  }
}
TEST(NetworkReview, AllDepthShortAliasesAreRejectedBeforeEndpointAccess) {
  for(auto path:{"/Books/Novel/BOOKEP~1.DAV","/Books/Novel/HIDDEN~1","/Books/Novel/DEEP/BOOKEP~2.DAV"}) {
    Storage={};WebServer server;server.requestUri=path;WebDAVHandler dav;dav.handleDelete(server);
    EXPECT_EQ(server.status,403);EXPECT_TRUE(Storage.probes.empty());EXPECT_TRUE(Storage.reads.empty());EXPECT_TRUE(Storage.mutations.empty());
    CrossPointWebServer web;web.server->args["path"]=path;web.handleDownload();EXPECT_EQ(web.server->status,403);EXPECT_TRUE(Storage.reads.empty());
  }
}
TEST(NetworkReview, PropfindFiltersEveryProtectedChildWithSharedPolicy) {
  Storage={};Storage.entries["/Books"]=true;
  for(auto name:{"ok.epub","a.davtmp","a.DAVBAK","XTCache","xtCACHE",".secret","BOOKEP~1.DAV"})Storage.entries[std::string("/Books/")+name]=false;
  WebServer server;server.requestUri="/Books";WebDAVHandler dav;dav.handlePropfind(server);
  EXPECT_EQ(server.status,207);EXPECT_EQ(dav.listed,(std::vector<std::string>{"/Books","/Books/ok.epub"}));
}
TEST(NetworkReview, WebMoveRejectsProtectedDestinationBeforeAnyStorageProbe) {
  for(int shape=0;shape<3;++shape) {
    Storage={};Storage.entries["/Books/a.epub"]=false;
    if(shape)Storage.entries["/Books/.secret/inner"]=shape==2;
    CrossPointWebServer web;web.server->args={{"path","/Books/a.epub"},{"dest","/Books/.secret/inner"}};web.handleMove();
    EXPECT_EQ(web.server->status,403);EXPECT_TRUE(Storage.probes.empty());EXPECT_TRUE(Storage.reads.empty());EXPECT_TRUE(Storage.mutations.empty());
  }
}
TEST(NetworkReview, RequiredSettingsAssetsAreRegisteredAndServed) {
  CrossPointWebServer web;web.registerAssets();
  for(auto entry:{std::pair{"/assets/web.css","text/css"},std::pair{"/assets/icons.svg","image/svg+xml"},std::pair{"/assets/crosspoint-icon.svg","image/svg+xml"}}) {
    ASSERT_TRUE(web.server->handlers.contains(entry.first));web.server->handlers.at(entry.first)();
    EXPECT_EQ(web.server->status,200);EXPECT_GT(staticResponseSize,0U);EXPECT_EQ(staticResponseMime,entry.second);
  }
}

TEST(NetworkReview, DestinationReadHandleAllocationFailureHasNoFileOrMetadataSideEffect) {
 Storage={};cleared.clear();Storage.entries["/a.epub"]=false;Storage.data["/a.epub"]="a";
 Storage.entries["/b.epub"]=false;Storage.data["/b.epub"]="b";Storage.readHandleFails=true;
 EXPECT_FALSE(commitNetworkFile("/a.epub","/b.epub"));EXPECT_EQ(Storage.data["/a.epub"],"a");EXPECT_EQ(Storage.data["/b.epub"],"b");
 EXPECT_TRUE(Storage.mutations.empty());EXPECT_TRUE(cleared.empty());EXPECT_FALSE(Storage.exists("/b.epub.davbak"));
}
