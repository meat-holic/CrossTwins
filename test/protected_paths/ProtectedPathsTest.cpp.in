enum { UPLOAD_FILE_START, UPLOAD_FILE_WRITE, UPLOAD_FILE_END, UPLOAD_FILE_ABORTED };
struct HTTPUpload { String filename; int status=UPLOAD_FILE_START; const uint8_t* buf=nullptr; size_t currentSize=0; };
struct FakeClient { bool live=true;bool connected(){return live;}void stop(){live=false;} };
struct WebServer {
  std::map<std::string, String> args;
  String requestUri, destination;
  int status = 0;
  HTTPUpload incoming;
  std::map<std::string,std::function<void()>> handlers;
  template<class F> void on(const char* path,int,F callback){handlers[path]=callback;}
  template<class... Args> void sendContent(Args&&...){}
  void setContentLength(size_t){}
  FakeClient connection; FakeClient& client(){return connection;}
  bool hasArg(const char* key) const { return args.contains(key); }
  String arg(const char* key) { return args[key]; }
  HTTPUpload& upload() { return incoming; }
  String uri() const { return requestUri; }
  String header(const char*) const { return destination; }
  size_t clientContentLength() const { return 0; }
  template<class... Args> void send(int code, Args&&...) { status = code; }
  static String urlDecode(const String& input) {
    String out;
    for (size_t i = 0; i < input.size(); ++i) {
      if (input[i] == '%' && i + 2 < input.size()) {
        unsigned b; if (std::sscanf(input.substr(i + 1, 2).c_str(), "%2x", &b) == 1) {
          out += static_cast<char>(b); i += 2; continue;
        }
      }
      out += input[i];
    }
    return out;
  }
};
