struct HalFile {
  bool opened = false, dir = false;
  std::string path;
  size_t position = 0;
  explicit operator bool() const { return opened; }
  bool isDirectory() const { return dir; }
  bool isOpen() const {return opened;}
  bool close();
  size_t size() const;
  int read(void*, size_t);
  HalFile openNextFile();
  bool getName(char* out,size_t n) const;
  bool rename(const char*);
  size_t write(const void*, size_t n);
};
struct StorageStub {
  enum class ReadOpenResult { Ok, IoFailure, ResourceFailure };
  bool readHandleFails=false;
  ReadOpenResult openFileForReadChecked(const char*,const char* path,HalFile& file) {
    if(readHandleFails)return ReadOpenResult::ResourceFailure;
    file=open(path);return file?ReadOpenResult::Ok:ReadOpenResult::IoFailure;
  }
  std::map<std::string, bool> entries;
  std::vector<std::string> mutations;
  std::vector<std::string> reads;
  mutable std::vector<std::string> probes;
  std::map<std::string,std::string> data;
  std::string failRemove, failRename, failOpen;
  bool failRead=false, failClose=false;
  size_t writeLimit=SIZE_MAX;
  bool rename(const char* src,const char* dst) {
    mutations.push_back("rename:"+std::string(dst));
    if (std::string(src)==failRename || !exists(src) || exists(dst)) return false;
    entries[dst]=entries[src]; entries.erase(src); data[dst]=data[src]; data.erase(src); return true;
  }
  bool exists(const char* p) const { probes.push_back(p); return entries.contains(p); }
  HalFile open(const char* p) { reads.push_back(p); if(std::string(p)==failOpen) return {}; return {exists(p), exists(p) ? entries.at(p) : false, p}; }
  bool openFileForWrite(const char*, const String& p, HalFile& f) {
    if(p==failOpen)return false; mutations.push_back("write:" + p); entries[p] = false; data[p]=""; f = {true, false, p}; return true;
  }
  bool mkdir(const char* p) { mutations.push_back("mkdir:" + std::string(p)); entries[p] = true; return true; }
  bool remove(const char* p) { mutations.push_back("remove:" + std::string(p)); if(std::string(p)==failRemove || (entries.contains(p) && entries.at(p)))return false; entries.erase(p); data.erase(p); return true; }
  bool rmdir(const char* p) {
    for(const auto& [path,dir]:entries) if(path.starts_with(std::string(p)+"/"))return false;
    mutations.push_back("rmdir:"+std::string(p));return entries.erase(p)>0;
  }
} Storage;
HalFile HalFile::openNextFile() {
  const std::string prefix=path=="/"?"/":path+"/";size_t index=0;
  for(const auto& [name,isDir]:Storage.entries) {
    if(!name.starts_with(prefix) || name.size()==prefix.size() || name.find('/',prefix.size())!=std::string::npos)continue;
    if(index++==position){++position;return {true,isDir,name};}
  }
  return {};
}
bool HalFile::getName(char* out,size_t n) const { const auto name=path.substr(path.find_last_of('/')+1);snprintf(out,n,"%s",name.c_str());return true; }
bool HalFile::rename(const char* p) { return Storage.rename(path.c_str(),p); }
bool HalFile::close() { opened=false; return !Storage.failClose; }
size_t HalFile::size() const { return Storage.data[path].size(); }
int HalFile::read(void* buf,size_t n) {
  if(Storage.failRead)return -1;
  auto& bytes=Storage.data[path];n=std::min(n,bytes.size()-position);
  memcpy(buf,bytes.data()+position,n);position+=n;return static_cast<int>(n);
}
size_t HalFile::write(const void* bytes, size_t n) {
  n=std::min(n,Storage.writeLimit);Storage.mutations.push_back("data:"+path);
  Storage.data[path].append(static_cast<const char*>(bytes),n);return n;
}
bool removeBookFile(const char* p) { if(!Storage.remove(p))return false;clearBookCache(p);return true; }
bool allocationFails=false;
template<class T, class... Args> auto makeUniqueNoThrow(Args&&... args) {
  return allocationFails ? std::unique_ptr<T>{} : std::make_unique<T>(std::forward<Args>(args)...);
}
using HalStorage=StorageStub;
