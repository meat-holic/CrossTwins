class String : public std::string {
 public:
  using std::string::string;
  String(const std::string& s) : std::string(s) {}
  bool isEmpty() const { return empty(); }
  size_t length() const { return size(); }
  bool startsWith(const char* s) const { return starts_with(s); }
  bool endsWith(const char* s) const { return ends_with(s); }
  bool equals(const char* s) const { return *this == s; }
  int indexOf(char c, int pos = 0) const { auto n = find(c, pos); return n == npos ? -1 : static_cast<int>(n); }
  int indexOf(const char* c) const { auto n = find(c); return n == npos ? -1 : static_cast<int>(n); }
  int lastIndexOf(char c) const { auto n = rfind(c); return n == npos ? -1 : static_cast<int>(n); }
  String substring(int first, int last = -1) const { return substr(first, last < 0 ? npos : last - first); }
  void replace(char from,char to){std::replace(begin(),end(),from,to);}
  char charAt(size_t n) const { return (*this)[n]; }
  void trim() { while (!empty() && std::isspace(static_cast<unsigned char>(back()))) pop_back();
    while (!empty() && std::isspace(static_cast<unsigned char>(front()))) erase(0, 1); }
};
