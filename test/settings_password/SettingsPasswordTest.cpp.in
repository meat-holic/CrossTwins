#define LOG_DBG(...) ((void)0)
void yield() {}
void resetTaskWatchdogIfSubscribed() {}
constexpr int CONTENT_LENGTH_UNKNOWN = -1;
class String : public std::string {
 public:
  using std::string::string;
  String(const std::string& value) : std::string(value) {}
  explicit String(int value) : std::string(std::to_string(value)) {}
};
enum class StrId {
  STR_SERVER_CONFIG_CONFIRM_REQUIRED,
  STR_SERVER_CONFIG_INVALID,
  STR_SERVER_CONFIG_SAVE_FAILED,
  STR_NONE_OPT,
  STR_KOREADER_USERNAME,
  STR_KOREADER_PASSWORD,
  STR_KOREADER_SYNC,
  STR_STATE_OFF,
  STR_STATE_ON
};
struct CrossPointSettings {
  uint8_t unrelated = 0;
  char directSecret[64] = {};
  int saves = 0;
  void saveToFile() { ++saves; }
} SETTINGS;
enum class KOReaderServerType : uint8_t { CROSSPOINT, KOSYNC, OTHER };
struct CredentialStore {
  std::string url;
  KOReaderServerType type = KOReaderServerType::CROSSPOINT;
  const std::string& getServerUrl() const { return url; }
  static bool isValidServerConfiguration(std::string_view, KOReaderServerType);
  bool saveServerConfiguration(std::string value, KOReaderServerType profile) {
    if (!isValidServerConfiguration(value, profile)) return false;
    url = std::move(value); type = profile; return true;
  }
  std::string username = "reader", password = "secret-한글";
  int saves = 0;
  const std::string& getUsername() const { return username; }
  const std::string& getPassword() const { return password; }
  std::string getMd5Password() const { return "internal-md5"; }
  void setCredentials(const std::string& user, const std::string& pass) {
    username = user;
    password = pass;
  }
  void saveToFile() { ++saves; }
} KOREADER_STORE;
using KOReaderCredentialStore = CredentialStore;
@VALIDATE_SERVER@
@SETTING_INFO@
struct DictionaryEntry {};
struct DictionaryRegistry {
  static void discover(std::vector<DictionaryEntry>&) {}
};
SettingInfo buildFontSizeSetting(const int*) { return {}; }
std::vector<SettingInfo> getSettingsList(const int* = nullptr, const std::vector<DictionaryEntry>* = nullptr) {
  std::vector<SettingInfo> settings;
  const auto emit = [&settings](SettingInfo info) { settings.push_back(std::move(info)); };
  @KO_METADATA@
  settings.push_back(SettingInfo::Toggle(StrId::STR_NONE_OPT, &CrossPointSettings::unrelated, "unrelated"));
  settings.push_back(
      SettingInfo::String(StrId::STR_NONE_OPT, SETTINGS.directSecret, sizeof(SETTINGS.directSecret), "directSecret")
          .withObfuscated());
  return settings;
}
struct FontSystem {
  int value = 0;
  const int& registry() const { return value; }
} sdFontSystem;
struct I18n {
  const char* get(StrId) const { return "label"; }
} I18N;
struct WebServer {
  std::string body, response;
  int status = 0;
  bool plain = true;
  bool hasArg(const char*) const { return plain; }
  String arg(const char*) const { return body; }
  void setContentLength(int) {}
  void send(int code, const char*, const String& text) {
    status = code;
    response = text;
  }
  void sendContent(const char* text) { response += text; }
};
class CrossPointWebServer {
 public:
  std::unique_ptr<WebServer> server = std::make_unique<WebServer>();
  void handleGetSettings() const;
  void handlePostSettings();
};
@GET_SETTINGS@
@POST_SETTINGS@
namespace freeink {
struct SecureHttpClient {
  std::map<std::string, std::string> headers;
  void addHeader(const std::string& key, const std::string& value) { headers[key] = value; }
};
}  // namespace freeink
namespace base64 {
// Transport adapter: tests assert the exact trusted input, not the encoding algorithm.
String encode(const char* value) { return value; }
}  // namespace base64
@AUTH_HEADERS@
class SettingsPassword : public testing::Test {
 protected:
  CrossPointWebServer web;
  void SetUp() override {
    SETTINGS = {};
    KOREADER_STORE = {};
  }
  JsonDocument get() {
    web.handleGetSettings();
    EXPECT_EQ(web.server->status, 200);
    JsonDocument doc;
    EXPECT_FALSE(deserializeJson(doc, web.server->response));
    return doc;
  }
  void post(const char* body) {
    web.server->body = body;
    web.handlePostSettings();
    EXPECT_EQ(web.server->status, 200);
  }
};
TEST_F(SettingsPassword, ConfiguredPasswordIsRedactedAtActualResponseBoundary) {
  auto doc = get();
  EXPECT_EQ(std::string(doc[1]["key"]), "koPassword");
  EXPECT_TRUE(doc[1]["value"].isNull());
  EXPECT_TRUE(doc[1]["hasPassword"].as<bool>());
  EXPECT_EQ(web.server->response.find(KOREADER_STORE.password), std::string::npos);
}
TEST_F(SettingsPassword, UnconfiguredPasswordReportsFalseWithNullValue) {
  KOREADER_STORE.password.clear();
  auto doc = get();
  EXPECT_TRUE(doc[1]["value"].isNull());
  EXPECT_FALSE(doc[1]["hasPassword"].as<bool>());
}
TEST_F(SettingsPassword, UnrelatedEditPreservesPassword) {
  const auto before = KOREADER_STORE.password;
  post("{\"unrelated\":1}");
  EXPECT_EQ(SETTINGS.unrelated, 1);
  EXPECT_EQ(KOREADER_STORE.password, before);
  EXPECT_EQ(KOREADER_STORE.saves, 0);
}
TEST_F(SettingsPassword, UsernameEditPreservesPassword) {
  const auto before = KOREADER_STORE.password;
  post("{\"koUsername\":\"updated\"}");
  EXPECT_EQ(KOREADER_STORE.username, "updated");
  EXPECT_EQ(KOREADER_STORE.password, before);
}
TEST_F(SettingsPassword, ExplicitNewPasswordUsesExistingSetterAndPersistence) {
  post("{\"koPassword\":\"new-비밀번호\"}");
  EXPECT_EQ(KOREADER_STORE.password, "new-비밀번호");
  EXPECT_EQ(KOREADER_STORE.saves, 1);
  get();
  EXPECT_EQ(web.server->response.find(KOREADER_STORE.password), std::string::npos);
}
TEST_F(SettingsPassword, ExplicitEmptyStringClearsPassword) {
  post("{\"koPassword\":\"\"}");
  EXPECT_TRUE(KOREADER_STORE.password.empty());
  EXPECT_EQ(KOREADER_STORE.saves, 1);
  auto doc = get();
  EXPECT_FALSE(doc[1]["hasPassword"].as<bool>());
}
TEST_F(SettingsPassword, NullOrNonStringCannotAccidentallyClearPassword) {
  const auto before = KOREADER_STORE.password;
  for (const auto* body :
       {"{\"koPassword\":null}", "{\"koPassword\":false}", "{\"koPassword\":123}", "{\"koPassword\":{}}"}) {
    post(body);
    EXPECT_EQ(KOREADER_STORE.password, before);
  }
  EXPECT_EQ(KOREADER_STORE.saves, 0);
}
TEST_F(SettingsPassword, DirectSecretMetadataAlsoRedactsTheResponse) {
  std::strcpy(SETTINGS.directSecret, "direct-secret");
  auto doc = get();
  EXPECT_TRUE(doc[3]["hasPassword"].as<bool>());
  EXPECT_TRUE(doc[3]["value"].isNull());
  EXPECT_EQ(web.server->response.find("direct-secret"), std::string::npos);
}
TEST_F(SettingsPassword, TrustedAuthHeadersStillReceiveStoredPassword) {
  post("{\"koPassword\":\"auth-secret\"}");
  freeink::SecureHttpClient http;
  applyAuthHeaders(http);
  EXPECT_EQ(http.headers["Authorization"], "Basic reader:auth-secret");
  EXPECT_EQ(http.headers["x-auth-key"], "internal-md5");
}
