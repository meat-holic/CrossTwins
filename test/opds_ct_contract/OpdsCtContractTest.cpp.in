#include <gtest/gtest.h>
#include <OpdsEntry.h>
#include <OpdsTransport.h>
#include <UrlUtils.h>
#include <string>
#include <vector>
#define LOG_DBG(...) ((void)0)
enum class StrId { STR_OPDS_NOT_A_BOOK };
struct HttpDownloader {
  enum DownloadError { OK, HTTP_ERROR, FILE_ERROR, ABORTED, UNAUTHORIZED };
  using Header=std::pair<std::string,std::string>;
};
struct Client {
  freeink::opds::HttpAuth auth;
  bool resolveOk=true;
  std::string resolved="https://books.test/plain.epub";
  bool resolveIndirect(const std::string&,std::string& out,bool& epub) {out=resolved;epub=true;return resolveOk;}
  auto downloadAuth() {return auth;}
};
class OpdsBookBrowserActivity {
 public:
  Client opdsClient;
  struct {std::string url="https://books.test/catalog/";} server;
  std::string currentPath="feed/",url,user,password,filename;
  std::vector<HttpDownloader::Header> headers;
  int begun=0,released=0,transfers=0,finished=0,verified=0,failed=0;
  bool validBook=true;
  HttpDownloader::DownloadError result=HttpDownloader::OK,lastResult=HttpDownloader::OK;
  void fail(StrId) {++failed;}
  void beginDownload(const std::string&) {++begun;}
  void releaseEntries() {++released;}
  std::string downloadDestination(const OpdsEntry&) {return "/books/ct.epub";}
  bool verifyAndRegisterEpub(const std::string&) {++verified;if(!validBook)++failed;return validBook;}
  void finishDownload(HttpDownloader::DownloadError r) {++finished;lastResult=r;}
  HttpDownloader::DownloadError downloadFile(const std::string& u,const std::string& f,
      const std::string& name,const std::string& pass,const std::vector<HttpDownloader::Header>& h) {
    ++transfers;url=u;filename=f;user=name;password=pass;headers=h;return result;
  }
  void downloadBook(const OpdsEntry& book);
};
@DOWNLOAD_BOOK@

TEST(OpdsCtContract, LicenseIsRejectedBeforeDownloadOrCatalogRelease) {
  OpdsBookBrowserActivity page;OpdsEntry book;book.lcpLicense=true;
  page.downloadBook(book);
  EXPECT_EQ(page.failed,1);EXPECT_EQ(page.begun,0);EXPECT_EQ(page.released,0);
  EXPECT_EQ(page.transfers,0);EXPECT_EQ(page.verified,0);EXPECT_EQ(page.finished,0);
}
TEST(OpdsCtContract, PlainDownloadKeepsDestinationBasicBearerAndCustomHeaders) {
  OpdsBookBrowserActivity page;OpdsEntry book;book.href="book.epub";book.title="한글";
  page.opdsClient.auth={"name","password","token",{{"X-Catalog","ct"}}};
  page.downloadBook(book);
  EXPECT_EQ(page.transfers,1);EXPECT_EQ(page.url,"https://books.test/catalog/feed/book.epub");
  EXPECT_EQ(page.filename,"/books/ct.epub");EXPECT_EQ(page.user,"name");EXPECT_EQ(page.password,"password");
  EXPECT_EQ(page.headers,(std::vector<HttpDownloader::Header>{{"X-Catalog","ct"},{"Authorization","Bearer token"}}));
  EXPECT_EQ(page.verified,1);EXPECT_EQ(page.finished,1);EXPECT_EQ(page.released,1);EXPECT_EQ(page.failed,0);
}
TEST(OpdsCtContract, IndirectResolutionKeepsOrdinaryBookPathAndFailsClosed) {
  OpdsBookBrowserActivity page;OpdsEntry book;book.indirect=true;book.href="publication.json";
  page.downloadBook(book);EXPECT_EQ(page.url,page.opdsClient.resolved);EXPECT_EQ(page.transfers,1);
  OpdsBookBrowserActivity failed;failed.opdsClient.resolveOk=false;failed.downloadBook(book);
  EXPECT_EQ(failed.failed,1);EXPECT_EQ(failed.transfers,0);EXPECT_EQ(failed.released,0);
}
TEST(OpdsCtContract, TransportFailureAndInvalidBookDoNotClaimSuccessfulRegistration) {
  OpdsEntry book;book.href="book.epub";
  for(auto result:{HttpDownloader::HTTP_ERROR,HttpDownloader::FILE_ERROR,HttpDownloader::ABORTED,HttpDownloader::UNAUTHORIZED}) {
    OpdsBookBrowserActivity page;page.result=result;page.downloadBook(book);
    EXPECT_EQ(page.verified,0);EXPECT_EQ(page.finished,1);EXPECT_EQ(page.lastResult,result);
  }
  OpdsBookBrowserActivity invalid;invalid.validBook=false;invalid.downloadBook(book);
  EXPECT_EQ(invalid.verified,1);EXPECT_EQ(invalid.failed,1);EXPECT_EQ(invalid.finished,0);
}
