struct RenderLock {
  inline static int depth = 0;
  RenderLock() { EXPECT_EQ(depth, 0); ++depth; }
  template <class T> explicit RenderLock(T&) : RenderLock() {}
  ~RenderLock() { --depth; }
};
struct EpubReaderActivity {
  struct Position { int spineIndex = 0, pageNumber = 0; };
  static constexpr int MAX_FOOTNOTE_DEPTH = 3;
  Position savedPositions[MAX_FOOTNOTE_DEPTH];
  int footnoteDepth = 0, currentSpineIndex = 1, nextPageNumber = 9, updates = 0;
  std::shared_ptr<Epub> epub = std::make_shared<Epub>();
  struct Section { int currentPage = 4; };
  std::unique_ptr<Section> section = std::make_unique<Section>();
  std::string pendingAnchor;
  void clearDeferredReposition() {}
  void requestUpdate() { ++updates; }
  void navigateToHref(const std::string&, bool);
};
@HREF@
namespace library { const char* libraryIndexPath() { return "library.idx"; } }
struct ActivityResult { bool isCancelled = false; };
struct ConfirmationActivity { ConfirmationActivity(int, int, const std::string&, const std::string&) {} };
struct LibraryListActivity {
  int renderer = 0, mappedInput = 0, rebuilds = 0, resets = 0, paints = 0;
  struct {
    bool opened = true;
    void close() { opened = false; }
    bool open(const char*) { opened = true; return true; }
  } index;
  std::function<void(const ActivityResult&)> callback;
  void startActivityForResult(std::unique_ptr<ConfirmationActivity>, std::function<void(const ActivityResult&)> cb) { callback = std::move(cb); }
  void swallowHeldReleases() {}
  void resetAfterRebuild() { ++resets; }
  void rebuildIndex() { ++rebuilds; }
  void closeRouting() {}
  void requestUpdate(bool = false) { ++paints; }
  void promptDeleteBookByPath(const std::string&, const std::string&);
};
@DELETE_DIALOG@

class ReaderUiContract : public testing::Test {
 protected:
  void SetUp() override { Storage = {}; SETTINGS = {}; RECENT_BOOKS = {}; APP_STATE = {}; GUI = {}; cleared.clear(); failAllocation = false; }
  void TearDown() override { for (const auto& [path, n] : Storage.handles) EXPECT_EQ(n, 0) << path; }
  void coverFixture() { Storage.files["/image.bmp"] = Bytes(4097, 7); Storage.files["/sleep.bmp"] = {1, 2, 3}; }
};
TEST_F(ReaderUiContract, CoverPromotionClosesHandlesAndReplacesCompleteContent) {
  coverFixture(); BmpViewerActivity viewer; viewer.doSetSleepCover();
  EXPECT_EQ(Storage.files["/sleep.bmp"], Storage.files["/image.bmp"]);
  EXPECT_FALSE(Storage.exists("/sleep.bmp.tmp")); EXPECT_FALSE(Storage.exists("/sleep.bmp.bak"));
  EXPECT_EQ(SETTINGS.saves, 1); EXPECT_EQ(viewer.enters, 1);
}
TEST_F(ReaderUiContract, CopyFailuresPreserveOldCoverAndSettings) {
  for (int failure = 0; failure < 5; ++failure) {
    Storage = {}; SETTINGS = {}; coverFixture(); failAllocation = false;
    if (failure == 0) Storage.failOpen = true;
    if (failure == 1) Storage.failRead = true;
    if (failure == 2) Storage.writeLimit = 3;
    if (failure == 3) Storage.failClose = true;
    if (failure == 4) failAllocation = true;
    BmpViewerActivity viewer; viewer.doSetSleepCover();
    EXPECT_EQ(Storage.files["/sleep.bmp"], (Bytes{1, 2, 3})); EXPECT_EQ(SETTINGS.saves, 0);
    for (const auto& [path, n] : Storage.handles) EXPECT_EQ(n, 0) << path;
  }
}
TEST_F(ReaderUiContract, FailedPromotionRollsBackAndCanRetry) {
  coverFixture(); Storage.failRenameFrom.insert("/sleep.bmp.tmp");
  BmpViewerActivity viewer; viewer.doSetSleepCover();
  EXPECT_EQ(Storage.files["/sleep.bmp"], (Bytes{1, 2, 3})); EXPECT_EQ(SETTINGS.saves, 0);
  Storage.failRenameFrom.clear(); viewer.doSetSleepCover(); EXPECT_EQ(SETTINGS.saves, 1);
}
TEST_F(ReaderUiContract, FailedRollbackKeepsOldBackupAndRefusesToOverwriteIt) {
  coverFixture(); Storage.failRenameFrom = {"/sleep.bmp.tmp", "/sleep.bmp.bak"};
  BmpViewerActivity viewer; viewer.doSetSleepCover();
  EXPECT_EQ(Storage.files["/sleep.bmp.bak"], (Bytes{1, 2, 3})); EXPECT_EQ(SETTINGS.saves, 0);
  Storage.failRenameFrom.clear(); viewer.doSetSleepCover();
  EXPECT_EQ(Storage.files["/sleep.bmp.bak"], (Bytes{1, 2, 3})); EXPECT_EQ(SETTINGS.saves, 0);
}
TEST_F(ReaderUiContract, FailedDeletionCannotDiscardReadingState) {
  Storage.files["book.txt"] = {1}; Storage.failRemove = true;
  EXPECT_FALSE(removeBookFile("book.txt")); EXPECT_TRUE(cleared.empty()); EXPECT_TRUE(Storage.exists("book.txt"));
  Storage.failRemove = false; EXPECT_TRUE(removeBookFile("book.txt")); EXPECT_EQ(cleared, (std::vector<std::string>{"txt:book.txt"}));
  Storage.files["book.md"] = {2}; EXPECT_TRUE(removeBookFile("book.md")); EXPECT_EQ(cleared.back(), "txt:book.md");
}
TEST_F(ReaderUiContract, DeleteDialogFailureReopensIndexWithoutChangingRecents) {
  Storage.files["book.txt"] = {1}; Storage.failRemove = true;
  LibraryListActivity library; library.promptDeleteBookByPath("book.txt", "book");
  ASSERT_TRUE(library.callback); EXPECT_FALSE(library.index.opened);
  library.callback({});
  EXPECT_TRUE(library.index.opened); EXPECT_TRUE(cleared.empty()); EXPECT_EQ(RECENT_BOOKS.removed, 0);
  EXPECT_EQ(library.rebuilds, 0); EXPECT_EQ(library.resets, 0); EXPECT_EQ(library.paints, 1);
}
TEST_F(ReaderUiContract, CancelledDeleteDialogReopensIndexAndPreservesSelection) {
  LibraryListActivity library; library.promptDeleteBookByPath("book.txt", "book"); library.callback({true});
  EXPECT_TRUE(library.index.opened); EXPECT_TRUE(cleared.empty()); EXPECT_EQ(RECENT_BOOKS.removed, 0);
  EXPECT_EQ(library.resets, 0);
}
TEST_F(ReaderUiContract, ConfirmedDeleteRebuildsOnlyAfterSuccessfulSourceRemoval) {
  Storage.files["book.txt"] = {1}; LibraryListActivity library;
  library.promptDeleteBookByPath("book.txt", "book"); library.callback({});
  EXPECT_TRUE(library.index.opened); EXPECT_FALSE(Storage.exists("book.txt"));
  EXPECT_EQ(RECENT_BOOKS.removed, 1); EXPECT_EQ(library.rebuilds, 1); EXPECT_EQ(library.resets, 1);
}
TEST_F(ReaderUiContract, CacheMoveFailureRestoresBookAndLeavesRecentsUntouched) {
  Storage.files["book.epub"] = {1}; Storage.files["old-cache"] = {2, 3};
  APP_STATE.openEpubPath = "book.epub"; Storage.failRenameFrom.insert("old-cache");
  moveFinishedBookToReadFolder("book.epub", "/read/book.epub", "old-cache");
  EXPECT_TRUE(Storage.exists("book.epub")); EXPECT_TRUE(Storage.exists("old-cache"));
  EXPECT_EQ(RECENT_BOOKS.updates, 0); EXPECT_EQ(APP_STATE.openEpubPath, "book.epub");
  Storage.failRenameFrom.clear(); moveFinishedBookToReadFolder("book.epub", "/read/book.epub", "old-cache");
  EXPECT_EQ(RECENT_BOOKS.updates, 1); EXPECT_EQ(APP_STATE.openEpubPath, "/read/book.epub");
}
TEST_F(ReaderUiContract, RecentBooksSkipDeletedEntriesAndRespectVisibleLimit) {
  HomeActivity home; home.loadRecentBooks(4); EXPECT_TRUE(home.recentBooks.empty());
  RECENT_BOOKS.books = {{"gone.epub", true}, {"a.txt"}, {"b.epub"}, {"c.xtc"}};
  home.loadRecentBooks(2); ASSERT_EQ(home.recentBooks.size(), 2u);
  EXPECT_EQ(home.recentBooks[0].path, "a.txt"); EXPECT_EQ(home.recentBooks[1].path, "b.epub");
}
TEST_F(ReaderUiContract, LyraSnapshotAndCoverTouchUseTheSameInsetContentArea) {
  HomeActivity home;
  home.coverGeometry();
  EXPECT_EQ(GUI.lastCover.x, 13); EXPECT_EQ(home.coverRectX, 13); EXPECT_EQ(home.coverRectW, 444);
  ASSERT_EQ(GUI.snapshot, &home.bookProgressSnapshot); EXPECT_EQ(GUI.snapshot->percent, 67);
  home.homeUsesSingleLyra = false; home.coverGeometry(); EXPECT_EQ(GUI.snapshot, nullptr);
}
TEST_F(ReaderUiContract, InvalidHrefDoesNotPopAFullFootnoteStack) {
  EpubReaderActivity reader; reader.footnoteDepth = reader.MAX_FOOTNOTE_DEPTH;
  reader.navigateToHref("missing.xhtml", true);
  EXPECT_EQ(reader.footnoteDepth, reader.MAX_FOOTNOTE_DEPTH); EXPECT_EQ(reader.currentSpineIndex, 1);
  EXPECT_NE(reader.section, nullptr); EXPECT_EQ(reader.updates, 0);
}
TEST_F(ReaderUiContract, ReleasedChildPageStillSavesTheOriginAndAnchor) {
  EpubReaderActivity reader; reader.section.reset(); reader.navigateToHref("valid.xhtml#note", true);
  ASSERT_EQ(reader.footnoteDepth, 1); EXPECT_EQ(reader.savedPositions[0].spineIndex, 1);
  EXPECT_EQ(reader.savedPositions[0].pageNumber, 9); EXPECT_EQ(reader.currentSpineIndex, 2);
  EXPECT_EQ(reader.pendingAnchor, "note"); EXPECT_EQ(RenderLock::depth, 0);
}
