using Bytes = std::vector<uint8_t>;
struct StorageStub;
struct HalFile {
  std::string path;
  size_t pos = 0;
  bool opened = false;
  ~HalFile() { if (opened) close(); }
  explicit operator bool() const { return opened; }
  bool close();
  int read(void*, size_t);
  size_t write(const uint8_t*, size_t);
};
struct StorageStub {
  std::map<std::string, Bytes> files;
  std::map<std::string, int> handles;
  std::set<std::string> failRenameFrom;
  bool failOpen = false, failRead = false, failClose = false, failRemove = false;
  size_t writeLimit = SIZE_MAX;
  bool exists(const char* p) const { return files.contains(p); }
  bool openFileForRead(const char*, const std::string& p, HalFile& f) {
    if (failOpen || !exists(p.c_str())) return false;
    f.path = p; f.opened = true; ++handles[p]; return true;
  }
  bool openFileForWrite(const char*, const std::string& p, HalFile& f) {
    if (failOpen) return false;
    files[p].clear(); f.path = p; f.opened = true; ++handles[p]; return true;
  }
  bool rename(const char* from, const char* to) {
    EXPECT_EQ(handles[from], 0); EXPECT_EQ(handles[to], 0);
    if (failRenameFrom.contains(from) || !exists(from) || exists(to)) return false;
    files[to] = std::move(files[from]); files.erase(from); return true;
  }
  bool remove(const char* p) { EXPECT_EQ(handles[p], 0); return !failRemove && files.erase(p) != 0; }
} Storage;
bool HalFile::close() {
  EXPECT_TRUE(opened); if (opened) --Storage.handles[path]; opened = false;
  return !Storage.failClose;
}
int HalFile::read(void* dst, size_t n) {
  if (Storage.failRead) return -1;
  n = std::min(n, Storage.files[path].size() - pos);
  std::memcpy(dst, Storage.files[path].data() + pos, n); pos += n; return static_cast<int>(n);
}
size_t HalFile::write(const uint8_t* src, size_t n) {
  n = std::min(n, Storage.writeLimit); Storage.files[path].insert(Storage.files[path].end(), src, src + n); return n;
}
namespace FsHelpers {
bool hasPngExtension(const std::string& p) { return p.ends_with(".png"); }
bool hasEpubExtension(const std::string& p) { return p.ends_with(".epub"); }
bool hasXtcExtension(const std::string& p) { return p.ends_with(".xtc"); }
bool hasTxtExtension(const std::string& p) { return p.ends_with(".txt"); }
bool hasMarkdownExtension(const std::string& p) { return p.ends_with(".md"); }
}
bool failAllocation = false;
template <class T, class... Args> std::unique_ptr<T> makeUniqueNoThrow(Args&&... args) {
  return failAllocation ? nullptr : std::make_unique<T>(std::forward<Args>(args)...);
}
