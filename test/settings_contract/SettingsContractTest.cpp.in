struct BoardConfig {
  static bool hasTouch() { return SETTINGS_TEST_TOUCH; }
  static bool hasHomeKey() { return SETTINGS_TEST_TOUCH; }
  static bool isX4Pro() { return SETTINGS_TEST_TOUCH; }
  static bool isX4Classic() { return false; }
};
struct UITheme {
  static bool supportsCoverGrid() { return SETTINGS_TEST_TOUCH; }
};
struct Sensor {
  bool available = true;
  bool isAvailable() const { return available; }
} halClock, halTiltSensor;
struct DictionaryEntry {
  std::string name;
};
struct DictionaryRegistry {
  static void discover(std::vector<DictionaryEntry>&) {}
};
enum class DocumentMatchMethod { Filename, Binary };
enum class KOReaderSyncBehavior { Ask, Smart };
enum class KOReaderServerType : uint8_t { CROSSPOINT, KOSYNC, OTHER };
struct CredentialStore {
  std::string user = "reader", pass = "secret", url = "https://example.invalid";
  DocumentMatchMethod match = DocumentMatchMethod::Filename;
  KOReaderSyncBehavior sync = KOReaderSyncBehavior::Ask;
  bool metadata = true;
  KOReaderServerType type = KOReaderServerType::CROSSPOINT;
  bool failServerSave = false;
  KOReaderServerType getServerType() const { return type; }
  static bool isValidServerConfiguration(std::string_view, KOReaderServerType);
  bool saveServerConfiguration(std::string value, KOReaderServerType profile) {
    if (failServerSave || !isValidServerConfiguration(value, profile)) return false;
    url = std::move(value); type = profile; return true;
  }
  const std::string& getUsername() const { return user; }
  const std::string& getPassword() const { return pass; }
  const std::string& getServerUrl() const { return url; }
  void setCredentials(const std::string& u, const std::string& p) {
    user = u;
    pass = p;
  }
  void setServerUrl(const std::string& value) { url = value; }
  DocumentMatchMethod getMatchMethod() const { return match; }
  void setMatchMethod(DocumentMatchMethod m) { match = m; }
  KOReaderSyncBehavior getSyncBehavior() const { return sync; }
  void setSyncBehavior(KOReaderSyncBehavior b) { sync = b; }
  bool getSendMetadata() const { return metadata; }
  void setSendMetadata(bool m) { metadata = m; }
  void saveToFile() {}
} KOREADER_STORE;
using KOReaderCredentialStore = CredentialStore;
@VALIDATE_SERVER@
namespace obfuscation {
std::string obfuscateToBase64(const char* value) { return value; }
std::string deobfuscateFromBase64(const char* value, size_t max, bool* ok, bool* tooLong) {
  *tooLong = std::strlen(value) > max;
  *ok = !*tooLong;
  return *ok ? value : "";
}
}  // namespace obfuscation
