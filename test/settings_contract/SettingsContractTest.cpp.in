void yield() {}
void resetTaskWatchdogIfSubscribed() {}
constexpr int CONTENT_LENGTH_UNKNOWN = -1;
class String : public std::string {
 public:
  using std::string::string;
  String(const std::string& s) : std::string(s) {}
  explicit String(int n) : std::string(std::to_string(n)) {}
};
struct FontSystem {
  SdCardFontRegistry value;
  int loads = 0;
  const SdCardFontRegistry& registry() const { return value; }
  void ensureLoaded(int&) {
    EXPECT_TRUE(fontLockHeld);
    ++loads;
    const auto points = readerFontPointSizes(&value, SETTINGS.sdFontFamilyName);
    if (!points.empty()) SETTINGS.fontPointSize = snapToNearestPointSize(points, SETTINGS.fontPointSize);
  }
} sdFontSystem;
struct WebServer {
  std::string body, response;
  int status = 0;
  bool plain = true;
  bool hasArg(const char*) const { return plain; }
  String arg(const char*) const { return body; }
  void setContentLength(int) {}
  void send(int code, const char*, const String& s) {
    status = code;
    response = s;
  }
  void sendContent(const char* s) { response += s; }
};
class CrossPointWebServer {
 public:
  std::unique_ptr<WebServer> server = std::make_unique<WebServer>();
  void handleGetSettings() const;
  void handlePostSettings();
};
@WEB@
struct RenderLock {
  RenderLock() {
    EXPECT_FALSE(fontLockHeld);
    fontLockHeld = true;
  }
  ~RenderLock() { fontLockHeld = false; }
};
class TextSettingsActivity {
 public:
  enum class Tab : uint8_t { Family, Size, Layout, Style, Count };
  const SdCardFontRegistry* registry_ = &sdFontSystem.value;
  int renderer = 0, currentFamilyIndex_ = -1, currentSizeIndex_ = -1, updates = 0;
  struct FontEntry {
    std::string name;
  };
  struct SizeEntry {
    std::string name;
    uint8_t pointSize;
  };
  std::vector<FontEntry> fonts_;
  std::vector<SizeEntry> sizes_;
  struct Nav {
    int selected = 0;
  } tabNavs[4];
  Tab tab_ = Tab::Family;
  textsettings::Profile profile_ = textsettings::Profile::Epub;
  void requestUpdate() { ++updates; }
  void confirmLayoutRow(int) {}
  void confirmStyleRow(int) {}
  void rebuildSizeList();
  void applyFamily(int);
  void applySize(int);
  void activateRow(int);
  int listCount() const;
};
